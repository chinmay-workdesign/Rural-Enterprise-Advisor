# Telegram Bot API (Instant setup via @BotFather, zero-cost, no business verification needed)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Meta WhatsApp Cloud API (Retained for future deployment)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_APP_SECRET=your_app_secret_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Google Gemini (Free Tier LLM & Multimodal Audio STT from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Database URL (defaults to local SQLite: sqlite:///./rural_advisor.db)
# DATABASE_URL=sqlite:///./rural_advisor.db

# App Settings
BACKEND_INTERNAL_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

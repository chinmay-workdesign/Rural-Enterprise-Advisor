# Telegram Bot API (Instant setup via @BotFather, zero-cost, no business verification needed)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Meta WhatsApp Cloud API (direct, no BSP)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_APP_SECRET=your_app_secret_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Google Gemini (Free tier LLM & Multimodal Audio STT from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GroqCloud LLM (Alternative/Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Digital India Bhashini Speech API
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Vector Store (Qdrant Cloud or local)
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Relational Database (Neon Postgres)
NEON_DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Storage (S3-compatible, zero egress fees)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=rural-dpr-storage
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# App Settings
BACKEND_INTERNAL_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
